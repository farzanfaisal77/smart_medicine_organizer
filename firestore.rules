rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and sub-collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Medicines sub-collection
      match /medicines/{medicineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Hardware activity logs sub-collection
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Device state sub-collection
      match /deviceState/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level deviceState fallback (for ESP32 direct reads/writes)
    match /deviceState/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // Top-level hardware registry
    match /hardwareRegistry/{deviceId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin managed
    }
  }
}
